# Get these from https://dashboard.handcash.io after creating an app.
# Set the app's "Authorization Success URL" to:
#   https://YOUR-DEPLOYED-URL/auth/handcash/callback
HANDCASH_APP_ID=
HANDCASH_APP_SECRET=

# The "house" account that holds the pot mid-game and pays out the winner.
# Create a normal HandCash account for your app (e.g. $satoshipongapp),
# authorize it against your own app once via the /auth/handcash/login flow,
# then copy the authToken you receive at the callback into this file.
# NOTE: prototype only — for production, add token-refresh handling, since
# authTokens can expire.
HANDCASH_HOUSE_HANDLE=
HANDCASH_HOUSE_AUTH_TOKEN=

# Cost of each paddle hit, in satoshis
HIT_FEE_SATS=10

PORT=3000
